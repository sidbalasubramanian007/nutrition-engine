# Required by scraper.py and test_ai.py (Gemini API access for macro estimation)
GEMINI_API_KEY=your-gemini-api-key-here

# Read by db.py's get_connection(), used by every script that touches the database
# (app.py via solver.py, check_db.py, migrate.py, migrate_limits.py, tag_data.py, seed_*.py).
# Both have sensible local defaults, so this file is only needed to point at a
# non-local database (e.g. staging/production).
DB_HOST=localhost
DB_NAME=nutrition_db
