# Required by scraper.py (Gemini API access for macro estimation)
GEMINI_API_KEY=your-gemini-api-key-here

# Read by db.py's get_connection(), used by everything that touches the database
# (app.py, solver.py, scripts/setup_db.py and scripts/check_db.py).
#
# Option A: a single connection URL (e.g. hosted Postgres). If set, it takes
# precedence and the DB_* variables below are ignored.
# DATABASE_URL=postgresql://user:password@host:5432/nutrition_db
#
# Option B: individual settings. All have local defaults, so this file is only
# needed to point at a non-local database or to supply credentials.
# Using docker-compose.yml? Set DB_PORT=5433 and give DB_USER/DB_PASSWORD values:
# compose creates that user and requires both.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nutrition_db
DB_USER=
DB_PASSWORD=

# Required by scripts/usda_lookup.py (USDA FoodData Central; free key at https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=
